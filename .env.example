# ── AI Provider Keys ──────────────────────────────────────────────────────────

# Google Gemini API key (System 2: grounded explanations + learning enrichment)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Jev TypeSafe AI API key (System 1: typed change classification)
# Must start with "jv_" — keys without this prefix use the calibrated local engine
JEV_API_KEY=jv_your_jev_key_here

# ── Server Configuration ──────────────────────────────────────────────────────

# Host to bind the HTTP server to.
# Use 127.0.0.1 for local-only access (default).
# Use 0.0.0.0 to bind all interfaces (required inside Docker).
AGENTTRACE_HOST=127.0.0.1

# ── Performance Tuning ────────────────────────────────────────────────────────

# Gemini API call timeout in seconds (default: 20).
# Increase if you see timeout errors on slow connections.
GEMINI_TIMEOUT=20

# Set to 1 to skip all Gemini enrichment calls entirely.
# Useful for CI, tests, or fast-path CLI usage without an API key.
AGENTTRACE_SKIP_ENRICHMENT=0

# ── Supabase Database Persistence ─────────────────────────────────────────────

# Supabase Project URL (e.g. https://your-project-id.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Key (or service_role key for server-side persistence)
SUPABASE_ANON_KEY=your_supabase_anon_or_service_role_key_here
